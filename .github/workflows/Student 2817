name: Daily M3U8 UUID Update

on:
  schedule:
    # Runs at 00:00 UTC every day
    - cron: '0 0 * * *'
  # Allows you to run the workflow manually from the Actions tab to test it
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-uuid:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Generate new UUID and update playlist
        run: |
          NEW_UUID=$(uuidgen | tr '[:upper:]' '[:lower:]')
          echo "Generated UUID: $NEW_UUID"

          # Replace 'plutotv_us.m3u8' with your actual filename
          sed -i -E "s/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/$NEW_UUID/g" plutotv_us.m3u8

      - name: Commit and push changes
        run: |
          git config --local user.email "github-actions[bot]@://github.com"
          git config --local user.name "github-actions[bot]"
          git add plutotv_us.m3u8
          git commit -m "chore: update playlist UUID" || exit 0
          git push
